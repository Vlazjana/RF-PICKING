*&---------------------------------------------------------------------*
*& Form handle_zpick4_init
**&---------------------------------------------------------------------*
FORM handle_zpick4_init
  USING    is_resource   TYPE /scwm/s_rsrc
           is_who        TYPE /scwm/s_who_int
  CHANGING cs_who_screen TYPE zsrf_zpisys_who_screen
           cs_ordim      TYPE /scwm/s_rf_ordim_confirm
           ct_pick_hus   TYPE /scwm/tt_rf_pick_hus.

  IF cs_who_screen-recover_flag IS NOT INITIAL.

    SELECT SUM( nista )
      FROM /scwm/ordim_c
      WHERE lgnum = @is_who-lgnum
        AND who   = @is_who-who
      INTO @cs_who_screen-zv_colli_prel.

    SELECT SUM( vsola )
      FROM /scwm/ordim_c
      WHERE lgnum = @is_who-lgnum
        AND who   = @is_who-who
      INTO @cs_who_screen-zv_colli_tot.

    WRITE cs_who_screen-zv_colli_prel TO gv_colli_prel_int NO-GROUPING DECIMALS 0.
    WRITE cs_who_screen-zv_colli_tot  TO gv_colli_totali_int NO-GROUPING DECIMALS 0.
    CONDENSE gv_colli_prel_int   NO-GAPS.
    CONDENSE gv_colli_totali_int NO-GAPS.

    DATA: ls_ctx_rec   TYPE zss_ewm_rf_recov_ctx,
          lv_found_rec TYPE abap_bool.

    PERFORM load_recov_ctx
     USING    is_resource-lgnum
           is_resource-rsrc
           is_who-who
     CHANGING ls_ctx_rec lv_found_rec.

    IF lv_found_rec = abap_true.
      cs_ordim-lgnum          = ls_ctx_rec-s_who_screen-lgnum.
      cs_ordim-who            = ls_ctx_rec-who-who.
      cs_who_screen-pdo       = ls_ctx_rec-s_who_screen-pdo.
      cs_who_screen-partyno   = ls_ctx_rec-s_who_screen-partyno.
      cs_who_screen-name_org1 = ls_ctx_rec-s_who_screen-name_org1.

      CLEAR ct_pick_hus.

      IF ls_ctx_rec-huident IS NOT INITIAL.
        APPEND VALUE /scwm/s_rf_pick_hus(
          pmat          = ls_ctx_rec-pmat
          pmat_guid     = ls_ctx_rec-pmat_guid
          huident       = ls_ctx_rec-huident
          huident_verif = ls_ctx_rec-huident_verif
          logpos        = ls_ctx_rec-logpos
          dstgrp        = ls_ctx_rec-dstgrp
          pointer       = ls_ctx_rec-pointer
          hukng         = ls_ctx_rec-hukng
        ) TO ct_pick_hus.
      ENDIF.

      /scwm/cl_rf_bll_srvc=>init_screen_param( ).
      /scwm/cl_rf_bll_srvc=>set_screen_param( 'ORDIM_CONFIRM' ).
      /scwm/cl_rf_bll_srvc=>set_screen_param( 'S_WHO_SCREEN' ).
      /scwm/cl_rf_bll_srvc=>set_screen_param( 'TT_ORDIM_CONFIRM' ).
      /scwm/cl_rf_bll_srvc=>set_screen_param( '/SCWM/TT_RF_PICK_HUS' ).
      /scwm/cl_rf_bll_srvc=>set_scr_tabname(
        iv_scr_tabname = '/SCWM/TT_RF_PICK_HUS' ).
    ENDIF.

  ELSE.

    /scwm/cl_rf_bll_srvc=>set_screen_param( 'ORDIM_CONFIRM' ).
    /scwm/cl_rf_bll_srvc=>set_screen_param( 'S_WHO_SCREEN' ).
    /scwm/cl_rf_bll_srvc=>set_screen_param( 'TT_ORDIM_CONFIRM' ).
    /scwm/cl_rf_bll_srvc=>set_screen_param( '/SCWM/TT_RF_PICK_HUS' ).
    /scwm/cl_rf_bll_srvc=>set_screen_param( 'S_WHO_SCREEN' ).

    SELECT SUM( nista ) AS sum_nista,
           SUM( vsola ) AS sum_vsola
      FROM /scwm/ordim_c
      WHERE lgnum = @is_who-lgnum
        AND who   = @is_who-who
      INTO @DATA(ls_sum).

    cs_who_screen-zv_colli_prel = ls_sum-sum_nista.
    cs_who_screen-zv_colli_tot  = ls_sum-sum_vsola.
    WRITE cs_who_screen-zv_colli_prel TO gv_colli_prel_int NO-GROUPING DECIMALS 0.
    WRITE cs_who_screen-zv_colli_tot  TO gv_colli_totali_int NO-GROUPING DECIMALS 0.
    CONDENSE gv_colli_prel_int   NO-GAPS.
    CONDENSE gv_colli_totali_int NO-GAPS.

    DATA: ls_ctx_norm   TYPE zss_ewm_rf_recov_ctx,
          lv_found_norm TYPE abap_bool.

    PERFORM load_recov_ctx
    USING    is_resource-lgnum
             is_resource-rsrc
             is_who-who
    CHANGING ls_ctx_norm lv_found_norm.

    IF lv_found_norm = abap_true.
      MOVE-CORRESPONDING cs_who_screen TO ls_ctx_norm-s_who_screen.
      READ TABLE ct_pick_hus INTO DATA(ls_hu_rec) INDEX 1.
      IF sy-subrc = 0.
        ls_ctx_norm-pmat          = ls_hu_rec-pmat.
        ls_ctx_norm-pmat_guid     = ls_hu_rec-pmat_guid.
        ls_ctx_norm-huident       = ls_hu_rec-huident.
        ls_ctx_norm-huident_verif = ls_hu_rec-huident_verif.
        ls_ctx_norm-logpos        = ls_hu_rec-logpos.
        ls_ctx_norm-dstgrp        = ls_hu_rec-dstgrp.
        ls_ctx_norm-pointer       = ls_hu_rec-pointer.
        ls_ctx_norm-hukng         = ls_hu_rec-hukng.
      ENDIF.

      ls_ctx_norm-recover_scr = step_pick4.
      PERFORM save_recov_ctx_partial
      USING    is_resource-lgnum
               is_resource-rsrc
               is_who-who
      CHANGING ls_ctx_norm.
    ENDIF.

    IF cs_who_screen-zv_colli_prel = 0.

      PERFORM delete_recov_ctx
      USING is_resource-lgnum
            is_resource-rsrc
            is_who-who.

      COMMIT WORK AND WAIT.
      /scwm/cl_rf_bll_srvc=>set_prmod( /scwm/cl_rf_bll_srvc=>c_prmod_background ).
      /scwm/cl_rf_bll_srvc=>set_fcode( /scwm/cl_rf_bll_srvc=>c_fcode_leave ).
      RETURN.
    ENDIF.

    COMMIT WORK AND WAIT.
    /scwm/cl_rf_bll_srvc=>set_prmod( /scwm/cl_rf_bll_srvc=>c_prmod_foreground ).

  ENDIF.

ENDFORM.
